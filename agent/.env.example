# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).

# --- Google Cloud / Vertex AI (the ONLY permitted AI provider) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
MODEL=gemini-2.5-flash
# Local dev auth: run `gcloud auth application-default login` once.

# --- ClickHouse Cloud (queried at runtime via the ClickHouse MCP server) ---
CLICKHOUSE_HOST=your-instance.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
# ^ 8443 = ClickHouse Cloud HTTPS port (what mcp-clickhouse/clickhouse-connect uses).
#   (The native clickhouse-client CLI uses 9440 instead — different tool, different port.)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=default

# --- ClickHouse MCP server launch ---
# The server runs as a separate subprocess via uvx (isolated from the agent's env,
# which must stay on mcp<2). Requires `uv` on PATH and network on first launch.
# MCP_CLICKHOUSE_CMD=uvx
# MCP_CLICKHOUSE_ARGS=mcp-clickhouse
